.page { padding: 24rpx; background: #f5f6f7; min-height: 100vh; box-sizing: border-box; }

.tip {
  font-size: 24rpx; color: #8a6d3b; background: #fcf8e3;
  border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 24rpx; line-height: 1.6;
}

.form { background: #fff; border-radius: 20rpx; padding: 8rpx 24rpx;
        box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.item { display: flex; align-items: center; border-bottom: 1rpx solid #f0f0f0; padding: 20rpx 0; }
.item:last-child { border-bottom: none; }
.label { width: 220rpx; font-size: 27rpx; color: #333; flex-shrink: 0; }
.input { flex: 1; font-size: 26rpx; color: #222; }
.pw { letter-spacing: 2rpx; }

.btns { display: flex; gap: 20rpx; margin-top: 36rpx; }
.btn { flex: 1; font-size: 29rpx; border-radius: 16rpx; }
.save { background: #1f6f43; color: #fff; }
.reset { background: #fff; color: #666; }
